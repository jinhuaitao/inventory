# 库存管理系统 —— 每日自动备份（systemd timer）
#
# 启用：
#   sudo systemctl enable --now inventory-backup.timer
#
# 查看下次执行时间与历史：
#   systemctl list-timers inventory-backup.timer
#   journalctl -u inventory-backup.service
#
# Persistent=true 表示：如果机器在计划时间点是关机状态，
# 开机后会尽快补跑一次，不会因为停机而整天空缺。

[Unit]
Description=库存管理系统 —— 每日自动备份数据库

[Timer]
Unit=inventory-backup.service
OnCalendar=*-*-* 03:30:00
# 打散执行时刻，避免多台机器同一秒一起写盘
RandomizedDelaySec=15m
# 错过计划时间时开机后补跑
Persistent=true

[Install]
WantedBy=timers.target

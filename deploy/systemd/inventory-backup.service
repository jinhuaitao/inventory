# 库存管理系统 —— 数据库备份（systemd）
#
# 配合 inventory-backup.timer 每日自动执行，也可以手动跑一次：
#   systemctl start inventory-backup.service
#
# 为什么不用 cp：
#   SQLite 开了 WAL 模式，最新提交的数据可能还在 /var/lib/inventory/inventory.db-wal 里，
#   尚未合并进主文件。服务运行中直接 cp inventory.db，拷到的可能是一个几乎空的库。
#   --backup-db 走的是 SQLite 的 VACUUM INTO：读事务取快照，产出已合并 WAL 的单文件，
#   因此**不需要停服务**，也不会丢数据。
#
# ⚠️ ReadWritePaths 指向备份目录，缺了它 ProtectSystem=strict 会让写入失败。
#    该目录由 deploy/install.sh 创建（/var/backups/inventory）。

[Unit]
Description=库存管理系统 —— 数据库备份
Documentation=https://github.com/jinhuaitao/inventory
After=inventory.service

[Service]
Type=oneshot
User=inventory
Group=inventory
WorkingDirectory=/opt/inventory

EnvironmentFile=-/etc/inventory/inventory.env
Environment=INVENTORY_DATA_DIR=/var/lib/inventory

# 备份到目录：自动生成 inventory-YYYYMMDD-HHMMSS.db，并只保留最近 14 份。
# 只清理严格匹配该命名格式的文件，手工放进去的东西不会被删。
ExecStart=/opt/inventory/bin/inventory-server --backup-db /var/backups/inventory --keep 14

# ---------- 加固（备份不需要网络）----------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX
UMask=0027

# 数据库只读、备份目录可写
ReadOnlyPaths=/var/lib/inventory
ReadWritePaths=/var/backups/inventory

# ---------- 日志 ----------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=inventory-backup

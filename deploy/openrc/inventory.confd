# /etc/conf.d/inventory —— 库存管理系统运行参数（Alpine / OpenRC）
#
# 由 /etc/init.d/inventory 自动 source。修改后执行：
#   rc-service inventory restart
#
# 权限建议 0600（文件内含会话密钥）：
#   chmod 600 /etc/conf.d/inventory

# ---------- 基础 ----------
INVENTORY_ENV="production"
INVENTORY_ADDR=":8080"
INVENTORY_DATA_DIR="/var/lib/inventory"
INVENTORY_LOG_DIR="/var/log/inventory"
INVENTORY_LOG_LEVEL="info"

# 对外访问地址，用于生成回调 / 分享链接（按需修改）
# INVENTORY_BASE_URL="https://inventory.example.com"

# ---------- 会话密钥（必填）----------
# 生产环境必须显式提供，至少 16 个字符。
# 生成方式：openssl rand -hex 32
INVENTORY_SESSION_SECRET=""

# ---------- 首次启动创建的管理员 ----------
INVENTORY_ADMIN_USERNAME="admin"
INVENTORY_ADMIN_EMAIL="admin@example.com"
# 留空则使用默认密码 Admin@12345，登录后请立即修改
INVENTORY_ADMIN_PASSWORD=""

# ---------- 演示数据 ----------
# 生产环境默认不写入。若首次启动时误写入，可用
#   /opt/inventory/bin/inventory-server --purge-demo-data --dry-run
# 预览后再执行清理。
# 也可以在 Web 界面「数据维护」页里预演并清理。
INVENTORY_SEED_DEMO_DATA="false"

# ---------- 数据库备份 ----------
# 备份目录。Web 界面「数据维护」页与每日定时任务共用这一个目录。
# 留空则取 <INVENTORY_DATA_DIR>/backups。
INVENTORY_BACKUP_DIR="/var/backups/inventory"
# 自动命名备份的保留份数（0 表示不自动清理）。
# 只清理严格匹配 inventory-YYYYMMDD-HHMMSS.db 的文件，手工命名的不会被删。
INVENTORY_BACKUP_KEEP="14"

# ---------- 在线更新（对接 GitHub Releases）----------
# 官方构建已在编译期注入仓库地址，通常无需设置。
INVENTORY_UPDATE_ENABLED="true"
# INVENTORY_UPDATE_REPO="jinhuaitao/inventory"
# 私有仓库或需要规避 API 限流时提供只读 Token
# INVENTORY_UPDATE_TOKEN=""
# 后台检查间隔
# INVENTORY_UPDATE_INTERVAL="6h"

# ---------- 注册与角色 ----------
INVENTORY_ALLOW_REGISTRATION="false"
INVENTORY_DEFAULT_ROLE="viewer"

# ---------- 登录安全 ----------
INVENTORY_MAX_LOGIN_ATTEMPTS="5"
INVENTORY_LOCKOUT_WINDOW="15m"
